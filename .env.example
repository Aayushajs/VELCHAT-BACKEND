# ── VelChat environment ──────────────────────────────────────────────────────
# Copy to `.env`. NEVER commit real secrets. Validated at boot by @velchat/config (zod, fail-closed).
#
# Two deployment profiles — flip the provider selectors, the app code is identical:
#   FREE-TIER (default): Neon + Atlas + Upstash + Cloudinary + Atlas Search + Grafana Cloud  (₹0)
#   SELF-HOST (scale):   Postgres + Mongo + Valkey + Kafka + MinIO + OpenSearch (docker-compose / K8s)

NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=example-service
# SERVICE_VERSION is auto-stamped from package.json + git short SHA (libs/config). Uncomment to pin (CI).
# SERVICE_VERSION=0.1.0
HTTP_PORT=3000
GRPC_PORT=50051
METRICS_PORT=9464

# ── Provider selection ──
EVENT_BUS=redis-streams          # redis-streams (Upstash, free) | kafka (self-host)
STORAGE_PROVIDER=cloudinary      # cloudinary (free) | s3 (MinIO/AWS)
SEARCH_PROVIDER=atlas            # atlas (Atlas Search, free) | opensearch (self-host)

# ── PostgreSQL → Neon (free) | local docker-compose ──
POSTGRES_URL=postgres://velchat:velchat@localhost:5432/velchat
POSTGRES_MAX_POOL=10

# ── MongoDB → Atlas (free) | local docker-compose. Also backs SEARCH_PROVIDER=atlas ──
MONGO_URL=mongodb://velchat:velchat@localhost:27017/velchat?authSource=admin

# ── Redis → Upstash (free, rediss://) | local Valkey. Cache + Redis Streams event bus ──
VALKEY_URL=redis://localhost:6379

# ── Media → Cloudinary (free). Required when STORAGE_PROVIDER=cloudinary ──
CLOUDINARY_URL=

# ── OpenTelemetry → Grafana Cloud (free) | local Tempo ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instanceID:token>   # Grafana Cloud

# ── Self-host only (EVENT_BUS=kafka) ──
# KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=velchat

# ── Self-host only (SEARCH_PROVIDER=opensearch) ──
# OPENSEARCH_NODE=http://localhost:9200
# OPENSEARCH_USERNAME=admin
# OPENSEARCH_PASSWORD=Velchat_dev_1!

# ── Self-host only (STORAGE_PROVIDER=s3 / MinIO) ──
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=velchatadmin
# S3_SECRET_KEY=velchatadminsecret
# S3_BUCKET=velchat-media

# ── Auth (placeholder; real keys via secrets manager in prod) ──
JWT_ISSUER=https://auth.velchat.local
JWT_ACCESS_TTL_SECONDS=900
# RS256 signing keypair for access tokens (PEM). Unset in dev → an ephemeral key is generated per
# boot (fine for a single instance; MUST be set + shared across replicas in prod).
# JWT_PRIVATE_PEM=
# JWT_PUBLIC_PEM=

# ── Mail → SMTP (§A3.5). Unset → emails are only logged (LogMailer, dev) ──
# Gmail (instant, Primary inbox): smtps://you%40gmail.com:<app-password>@smtp.gmail.com:465
# Brevo/Postfix: smtp://user:pass@host:587  (URL-encode @/: → %40). Use a VERIFIED/authenticated sender.
# SMTP_URL=smtp://user:pass@smtp.host:587
MAIL_FROM=VelChat <no-reply@velchat.local>
# Logo shown at the top of every email (public URL). Unset → text "VelChat" wordmark.
# Host it via: node scripts/upload-logo.mjs <image>  → prints a Cloudinary URL to paste here.
# MAIL_LOGO_URL=https://res.cloudinary.com/<cloud>/image/upload/velchat/email-logo
# Email footer links (website + LinkedIn icons; support text links to the website). Have defaults.
# MAIL_WEBSITE_URL=https://velcart.netlify.app/
# MAIL_LINKEDIN_URL=https://www.linkedin.com/company/velcart/
# MAIL_SUPPORT_TEXT=support@velcart.com

# ── Reverse-OTP gateway (₹0 verification, §B2.2) — Asterisk/FreeSWITCH webhook ──
# REVOTP_WEBHOOK_SECRET=change-me-shared-secret   # HMAC secret the SIP gateway signs the webhook with
# REVOTP_DID=+911140000000                        # the owned inbound number users missed-call / SMS

# ── 2Factor.in SMS OTP (additive auth) — AUTOGEN send + VERIFY3 verify. NEVER commit the real key. ──
# OTP_API_KEY=your-2factor-api-key                 # from the 2Factor.in dashboard; .env only, never git
# OTP_TEMPLATE=Temp1                               # 2Factor SMS template name
# OTP_DEV_MODE=true                                # while true, only OTP_DEV_PHONE may receive an OTP
# OTP_DEV_PHONE=+911140000000                      # the only phone allowed to receive OTP in dev-mode

# ── Push → Web Push (VAPID) + FCM. Unset → no-op/log transport ──
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@velchat.local
# FCM (Android/iOS) — take these THREE from the Firebase service-account JSON. NEVER commit the JSON;
# only put its values here (or in your secrets manager). Escaped \n in the key is fine.
# FCM_PROJECT_ID=velchat-xxxxx
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxxx@velchat-xxxxx.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Calls & meetings → LiveKit SFU (§A17). Required for call-service to mint join tokens ──
# LIVEKIT_URL=wss://your-livekit-host            # what clients connect to
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=3600
