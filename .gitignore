# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo
.turbo/

# test / coverage
coverage/
.nyc_output/

# env & secrets (NEVER commit)
.env
.env.*
!.env.example
!env/*.example
*.pem
*.key
*.crt
secrets/
# cloud service-account keys (Firebase/FCM, GCP) — configure via env, never commit the JSON
*firebase*adminsdk*.json
*-service-account*.json
*.serviceaccount.json
gcp-*.json
google-credentials*.json

# logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# editor / os
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# generated proto types (regenerated by buf)
libs/shared-types/src/gen/

# misc
*.local
tmp/
CLAUDE.md
.claude/

.early.coverage
# Jest per-package transform cache (see jest.preset.cjs)
.jest-cache/

# Oracle deployment env (secrets) — template is .env.oracle.example
.env.oracle
