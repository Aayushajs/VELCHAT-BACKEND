# ── VelChat on AWS (t4g.small, free until 31 Dec 2026) ───────────────────────────
# cp deploy/aws/.env.example deploy/aws/.env  and fill the marked values. NEVER commit .env.
#
# 2 GB of RAM fits the six services but not a local data tier, so Postgres / Mongo / Redis are
# external here. Everything else is byte-identical to the Oracle profile.

NODE_ENV=production
LOG_LEVEL=info
DOMAIN=chat.example.com          # your DNS name; Caddy gets a free Let's Encrypt cert for it
CORS_ORIGINS=https://chat.example.com

# ── Deployment profile ──
# axis6 = the six services in this compose file. lean3 / full13 exist for smaller boxes and
# rollback respectively — see deploy/PORTABILITY.md.
SPLIT_PROFILE=axis6      # six services; 2 GB has room for the processes, not the databases

# ── External data tier (2 GB cannot host the databases) ──
# Any managed or free-tier provider works; these are URLs, not vendors.
POSTGRES_URL=                      # REQUIRED — RDS, Aurora Serverless v2, or Neon free
POSTGRES_MAX_POOL=6
MONGO_URL=                         # REQUIRED — DocumentDB or Atlas free
VALKEY_URL=                        # REQUIRED — ElastiCache or Upstash
# NOTE: metered Redis is a poor fit for the event bus — Redis Streams consumers read continuously.
# Upstash free allows 500k commands/month, which this backend can exhaust in about a day.

# ── Providers ──
EVENT_BUS=redis-streams            # local Valkey; unlimited commands, no metered quota
STORAGE_PROVIDER=s3                # real AWS S3 — the same adapter Oracle uses
SEARCH_PROVIDER=atlas              # Mongo text search (no OpenSearch cluster needed)

# Leave S3_ENDPOINT EMPTY for AWS S3; it exists for MinIO and Oracle Object Storage.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=velchat-media

# ── Auth (REQUIRED — a service refuses to boot without JWT_PUBLIC_PEM) ──
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
# openssl rsa -in jwt.key -pubout -out jwt.pub
# Then paste with literal \n, or mount the files and use the *_FILE form.
JWT_ISSUER=https://chat.example.com
JWT_PRIVATE_PEM=
JWT_PUBLIC_PEM=
AUTH_DEV_INSECURE=false

# ── Service-to-service auth (REQUIRED) ──
# The WebSocket fabric checks conversation membership before acting on a receipt/typing/skdm frame.
# Without this secret those frames are REFUSED — delivered and read ticks silently stop working
# while /health stays green. Generate: openssl rand -base64 32
INTERNAL_API_SECRET=

# ── WebSocket + edge limits ──
WS_MAX_PAYLOAD_BYTES=65536
WS_INBOUND_PER_SECOND=40
RATE_LIMIT_MAX=6000
RATE_LIMIT_WINDOW_MS=60000
KEEP_WARM_MS=0                     # always-on instance            # MUST stay false; it is refused in production anyway

# ── Backups → Oracle Object Storage (a service that is NOT on the VM, so it survives reclamation) ──
BACKUP_BUCKET=velchat-backups
BACKUP_RETAIN_DAYS=7

# ── Observability (Grafana Cloud free tier, or leave unset) ──
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
