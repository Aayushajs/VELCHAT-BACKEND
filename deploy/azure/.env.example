# ── VelChat on Azure (B1S free allowance, or Azure for Students) ──────────────────
# cp deploy/azure/.env.example deploy/azure/.env  and fill the marked values. NEVER commit .env.
#
# Sized for the FREE allowance: B1S, 1 vCPU / 1 GB, 750 h/month. That is one Node process, so this
# profile runs `velchat-mono` — every feature group in a single process, same code as the six.
# Azure for Students adds $100/12 months of credit on top; spend it on managed data services
# rather than on compute, and the compute stays inside the free allowance.

NODE_ENV=production
LOG_LEVEL=info
DOMAIN=chat.example.com          # your DNS name; Caddy gets a free Let's Encrypt cert for it
CORS_ORIGINS=https://chat.example.com

# ── Deployment profile ──
# axis6 = the six services in this compose file. lean3 / full13 exist for smaller boxes and
# rollback respectively — see deploy/PORTABILITY.md.
SPLIT_PROFILE=mono       # ONE process. 1 GB cannot hold six Node services.

# -- Container images --
# Published by .github/workflows/release.yml on every merge to main, tagged with the version it
# derived from the commit messages. GHCR namespaces by repository OWNER, so a fork sets
# IMAGE_REPO to its own org and nothing else changes.
IMAGE_REPO=ghcr.io/velcart
TAG=latest               # CD overrides this per deploy with the exact released version; pinning
                         # a version here is what makes a rollback `TAG=0.4.1 docker compose up -d`

# ── Data tier: Postgres and Mongo external, Valkey local ──
# Valkey stays on the box on purpose: it is ~60 MB, and a metered Redis is the worst home for the
# event bus (Redis Streams consumers read continuously).
POSTGRES_URL=                      # REQUIRED — Azure Database for PostgreSQL, or Neon free
POSTGRES_MAX_POOL=4                # one process, so one pool — keep it small
MONGO_URL=                         # REQUIRED — Cosmos DB for MongoDB (free tier), or Atlas free
VALKEY_URL=redis://valkey:6379     # local container, in this compose file

# ── Providers ──
EVENT_BUS=redis-streams            # local Valkey; unlimited commands, no metered quota
STORAGE_PROVIDER=azure-blob        # Azure Blob is NOT S3-compatible — it has its own adapter
SEARCH_PROVIDER=atlas              # Mongo text search (no OpenSearch cluster needed)

# Azure Blob. AZURE_STORAGE_KEY is a secret; the adapter signs with it and never transmits it.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=velchat-media
# AZURE_BLOB_ENDPOINT=             # only for Azurite or a private endpoint

# ── Auth (REQUIRED — a service refuses to boot without JWT_PUBLIC_PEM) ──
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
# openssl rsa -in jwt.key -pubout -out jwt.pub
# Then paste with literal \n, or mount the files and use the *_FILE form.
JWT_ISSUER=https://chat.example.com
JWT_PRIVATE_PEM=
JWT_PUBLIC_PEM=
AUTH_DEV_INSECURE=false

# ── Service-to-service auth (REQUIRED) ──
# The WebSocket fabric checks conversation membership before acting on a receipt/typing/skdm frame.
# Without this secret those frames are REFUSED — delivered and read ticks silently stop working
# while /health stays green. Generate: openssl rand -base64 32
INTERNAL_API_SECRET=

# ── WebSocket + edge limits ──
WS_MAX_PAYLOAD_BYTES=65536
WS_INBOUND_PER_SECOND=40
RATE_LIMIT_MAX=6000
RATE_LIMIT_WINDOW_MS=60000
KEEP_WARM_MS=0                     # always-on instance            # MUST stay false; it is refused in production anyway

# ── Backups → Azure Blob (a service that is NOT on the VM, so it survives losing the VM) ──
BACKUP_CONTAINER=velchat-backups
BACKUP_RETAIN_DAYS=7

# ── Observability (Grafana Cloud free tier, or leave unset) ──
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
