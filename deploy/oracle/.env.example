# ── VelChat on Oracle Cloud Always Free ──────────────────────────────────────────
# cp .env.oracle.example .env.oracle  and fill the marked values. NEVER commit .env.oracle.
#
# This profile uses ONLY Always Free resources: one A1 VM (2 OCPU / 12 GB), the 200 GB block
# volume, 20 GB Object Storage, 10 TB/month egress. It never touches the $300 trial credits, so
# nothing changes when they expire.

NODE_ENV=production
LOG_LEVEL=info
DOMAIN=chat.example.com          # your DNS name; Caddy gets a free Let's Encrypt cert for it
CORS_ORIGINS=https://chat.example.com

# ── Deployment profile ──
# axis6 = the six services in this compose file. lean3 / full13 exist for smaller boxes and
# rollback respectively — see deploy/PORTABILITY.md.
SPLIT_PROFILE=axis6

# ── Local data tier (no external quota, no internet hop per query) ──
POSTGRES_USER=velchat
POSTGRES_PASSWORD=                 # REQUIRED — generate: openssl rand -base64 24
POSTGRES_DB=velchat
POSTGRES_URL=postgres://velchat:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/velchat
POSTGRES_MAX_POOL=6

MONGO_USER=velchat
MONGO_PASSWORD=                    # REQUIRED — generate: openssl rand -base64 24
MONGO_URL=mongodb://velchat:REPLACE_WITH_MONGO_PASSWORD@mongo:27017/velchat?authSource=admin

VALKEY_URL=redis://valkey:6379

# ── Providers ──
EVENT_BUS=redis-streams            # local Valkey; unlimited commands, no metered quota
STORAGE_PROVIDER=s3                # Oracle Object Storage speaks the S3 API
SEARCH_PROVIDER=atlas              # Mongo text search on the local Mongo (no OpenSearch needed)

# Oracle Object Storage, S3-compatible endpoint. Create a Customer Secret Key in the OCI console.
S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-mumbai-1.oraclecloud.com
S3_REGION=ap-mumbai-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=velchat-media

# ── Auth (REQUIRED — a service refuses to boot without JWT_PUBLIC_PEM) ──
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
# openssl rsa -in jwt.key -pubout -out jwt.pub
# Then paste with literal \n, or mount the files and use the *_FILE form.
JWT_ISSUER=https://chat.example.com
JWT_PRIVATE_PEM=
JWT_PUBLIC_PEM=
AUTH_DEV_INSECURE=false

# ── Service-to-service auth (REQUIRED) ──
# The WebSocket fabric checks conversation membership before acting on a receipt/typing/skdm frame.
# Without this secret those frames are REFUSED — delivered and read ticks silently stop working
# while /health stays green. Generate: openssl rand -base64 32
INTERNAL_API_SECRET=

# ── WebSocket + edge limits ──
WS_MAX_PAYLOAD_BYTES=65536
WS_INBOUND_PER_SECOND=40
RATE_LIMIT_MAX=6000
RATE_LIMIT_WINDOW_MS=60000
KEEP_WARM_MS=0                     # always-on VM: nothing hibernates, so no need            # MUST stay false; it is refused in production anyway

# ── Backups → Oracle Object Storage (a service that is NOT on the VM, so it survives reclamation) ──
BACKUP_BUCKET=velchat-backups
BACKUP_RETAIN_DAYS=7

# ── Observability (Grafana Cloud free tier, or leave unset) ──
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
