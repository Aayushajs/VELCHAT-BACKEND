{
  "name": "velchat",
  "version": "0.1.2",
  "private": true,
  "description": "VelChat — free, OSS, self-hostable WhatsApp + Teams + Slack hybrid (backend monorepo)",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup": "pnpm install && pnpm build && turbo run build --filter=\"./libs/*\"",
    "build": "turbo run build",
    "build:libs": "pnpm install && turbo run build --filter=\"./libs/*\"",
    "build:services": "turbo run build --filter=\"./apps/*\"",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --parallel",
    "start:all": "node tools/gateway/start-all.mjs",
    "gateway": "node tools/gateway/dev-gateway.mjs",
    "docs": "node tools/print-docs.mjs",
    "dev:edge": "pnpm --filter @velchat/edge-gateway dev",
    "dev:identity": "pnpm --filter @velchat/identity-service dev",
    "dev:messaging": "pnpm --filter @velchat/messaging-service dev",
    "dev:realtime": "pnpm --filter @velchat/realtime-service dev",
    "dev:content": "pnpm --filter @velchat/content-service dev",
    "dev:platform": "pnpm --filter @velchat/platform-service dev",
    "format": "prettier --write \"**/*.{ts,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yaml,yml}\"",
    "proto:gen": "buf generate",
    "db:up": "docker compose -f docker/compose.yml up -d postgres mongo valkey",
    "db:down": "docker compose -f docker/compose.yml down",
    "db:logs": "docker compose -f docker/compose.yml logs -f",
    "db:migrate": "pnpm --filter @velchat/migrations migrate",
    "infra:up": "docker compose -f docker/compose.yml up -d",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:tag": "changeset tag",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=main",
    "prepare": "husky",
    "vm": "node scripts/vm.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
